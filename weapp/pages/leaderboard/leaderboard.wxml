<view class="container">
  <view class="leaderboard-header">
    <view class="leaderboard-title">📜 贞观风云榜</view>
    <view class="leaderboard-subtitle">凌烟阁主，谁与争锋</view>
    <view class="leaderboard-myrank" wx:if="{{myRank}}">我的排名：第 {{myRank}} 名</view>
    <view class="leaderboard-mock-badge" wx:if="{{isMock}}">示例数据</view>
  </view>

  <view class="leaderboard-list" wx:if="{{!loading}}">
    <view class="leaderboard-item {{item.rank <= 3 ? 'top' : ''}} {{item.isMe ? 'me' : ''}}" wx:for="{{leaderboard}}" wx:key="rank">
      <view class="rank-number">{{item.rank}}</view>
      <view class="player-info">
        <view class="player-name">{{item.nickname}}</view>
        <view class="player-meta">{{item.meta}}</view>
      </view>
      <view class="player-score">{{item.score}}分</view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>
</view>
