<!-- 商铺页面：去广告、名臣卡、剧本、加成包 -->
<view class="container shop-container">
  <view class="shop-header">
    <view class="shop-title">皇家商铺</view>
    <view class="shop-subtitle">支持贞观之治，获取强力助力</view>
  </view>

  <view class="products">
    <view 
      class="product-card {{item.purchased ? 'purchased' : ''}}"
      wx:for="{{products}}"
      wx:key="id"
    >
      <view class="product-top">
        <view class="product-icon">{{item.icon}}</view>
        <view class="product-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-desc">{{item.desc}}</view>
        </view>
      </view>
      <view class="product-bottom">
        <view class="product-price">¥{{item.price}}.00</view>
        <button 
          class="btn {{item.purchased || purchasingId || restoring ? 'btn-disabled' : 'btn-primary'}}"
          bindtap="purchaseItem"
          data-id="{{item.id}}"
          disabled="{{item.purchased || purchasingId || restoring}}"
          loading="{{purchasingId === item.id}}"
        >
          {{item.purchased ? '已获得' : (purchasingId === item.id ? '处理中' : '立即购买')}}
        </button>
      </view>
    </view>
  </view>

  <view class="shop-footer">
    <text>付费功能暂未开通，当前无法购买</text>
    <button class="btn btn-primary" bindtap="restorePurchases" loading="{{restoring}}" disabled="{{restoring || purchasingId}}">{{restoring ? '恢复中' : '恢复已核验权益'}}</button>
    <text>如遇问题请联系客服</text>
  </view>
</view>
