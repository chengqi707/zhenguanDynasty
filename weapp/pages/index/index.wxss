.index-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--gold);
  letter-spacing: 8rpx;
  text-shadow: 4rpx 4rpx 8rpx rgba(0,0,0,0.5);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--gold-light);
  opacity: 0.8;
}

/* V3.0 周目信息 */
.cycle-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  gap: 8rpx;
}

.cycle-badge {
  background: linear-gradient(135deg, var(--gold), var(--red));
  color: var(--paper);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.cycle-bonus {
  font-size: 24rpx;
  color: var(--gold-light);
  opacity: 0.9;
}

.characters-preview {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-bottom: 50rpx;
}

.char-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--black-light);
  border: 2rpx solid var(--gold);
  border-radius: 16rpx;
  padding: 20rpx;
  min-width: 120rpx;
}

.char-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.char-name {
  font-size: 24rpx;
  color: var(--gold-light);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: 480rpx;
}

.action-btn {
  width: 100%;
  padding: 24rpx;
  font-size: 32rpx;
}

.version {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: var(--text-light);
  opacity: 0.6;
}

/* 难度选择 */
.difficulty-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.difficulty-item {
  border: 2rpx solid var(--gold-light);
  border-radius: 12rpx;
  padding: 20rpx;
  background: var(--black-light);
  opacity: 0.7;
}

.difficulty-item.selected {
  border-color: var(--gold);
  background: rgba(201, 162, 39, 0.15);
  opacity: 1;
}

.diff-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--red);
  margin-bottom: 8rpx;
}

.diff-desc {
  font-size: 26rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}

.diff-params {
  font-size: 22rpx;
  color: var(--text-light);
}

/* V3.0 选择器 */
.selector-section {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: var(--black-light);
  border-radius: 12rpx;
  border: 1rpx solid var(--gold-light);
}

.selector-label {
  font-size: 26rpx;
  color: var(--gold-light);
  margin-bottom: 12rpx;
}

.selector-value {
  font-size: 30rpx;
  color: var(--text);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background: var(--black);
  border-radius: 8rpx;
}

.selector-value .arrow {
  color: var(--gold);
  font-size: 24rpx;
}

.namecard-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.namecard-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: var(--black);
  border: 2rpx solid var(--gold-light);
  border-radius: 12rpx;
  min-width: 140rpx;
  opacity: 0.6;
}

.namecard-item.selected {
  border-color: var(--gold);
  background: rgba(201, 162, 39, 0.15);
  opacity: 1;
}

.namecard-item.locked {
  opacity: 0.3;
  filter: grayscale(1);
}

.namecard-emoji {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.namecard-name {
  font-size: 24rpx;
  color: var(--text);
  font-weight: bold;
}

.namecard-title {
  font-size: 20rpx;
  color: var(--text-light);
}

/* 剧本列表 */
.script-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.script-item {
  border: 2rpx solid var(--gold-light);
  border-radius: 12rpx;
  padding: 20rpx;
  background: var(--black-light);
  opacity: 0.7;
}

.script-item.selected {
  border-color: var(--gold);
  background: rgba(201, 162, 39, 0.15);
  opacity: 1;
}

.script-item.locked {
  opacity: 0.4;
}

.script-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--red);
  margin-bottom: 8rpx;
}

.script-desc {
  font-size: 24rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}

.script-lock {
  font-size: 22rpx;
  color: var(--gold-light);
}

/* 设置 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--gold-light);
  font-size: 30rpx;
  color: var(--text);
}

.ad-removed {
  color: var(--gold);
}

/* 大弹窗 */
.modal-large {
  max-height: 80vh;
  overflow-y: auto;
}
