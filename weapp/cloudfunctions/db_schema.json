{
  "description": "凌烟阁密档 云开发数据库 Schema",
  "deploymentNote": "securityRules 为部署要求，须在云开发控制台逐集合应用，不会随上传云函数自动生效。受保护集合禁止小程序端直接读写，仅允许服务端访问。",
  "collections": [
    {
      "name": "game_saves",
      "description": "用户游戏存档",
      "securityRules": { "read": false, "write": false },
      "fields": {
        "_openid": { "type": "string", "required": true, "description": "用户openid" },
        "slotId": { "type": "string", "required": true, "description": "存档位ID" },
        "saveData": { "type": "object", "required": true, "description": "存档数据" },
        "createTime": { "type": "date", "required": true },
        "updateTime": { "type": "date", "required": true }
      },
      "indexes": [
        { "name": "openid_slotId", "keys": { "_openid": 1, "slotId": 1 }, "unique": true }
      ]
    },
    {
      "name": "leaderboard",
      "description": "全球排行榜",
      "fields": {
        "_openid": { "type": "string", "required": true },
        "nickname": { "type": "string", "required": false },
        "score": { "type": "number", "required": true },
        "title": { "type": "string", "required": false },
        "cycle": { "type": "number", "required": false },
        "updateTime": { "type": "date", "required": true }
      },
      "indexes": [
        { "name": "score", "keys": { "score": -1 } }
      ]
    },
    {
      "name": "purchase_logs",
      "description": "购买记录",
      "securityRules": { "read": false, "write": false },
      "fields": {
        "_openid": { "type": "string", "required": true },
        "productId": { "type": "string", "required": true },
        "type": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "createTime": { "type": "date", "required": true }
      },
      "indexes": [
        { "name": "openid_time", "keys": { "_openid": 1, "createTime": -1 } }
      ]
    },
    {
      "name": "orders",
      "description": "微信支付订单",
      "securityRules": { "read": false, "write": false },
      "fields": {
        "_openid": { "type": "string", "required": true },
        "orderId": { "type": "string", "required": true },
        "productId": { "type": "string", "required": true },
        "productName": { "type": "string", "required": true },
        "price": { "type": "number", "required": true },
        "status": { "type": "string", "required": true },
        "paymentVerified": { "type": "boolean", "required": false, "description": "仅可信支付服务在验签或主动查单且核对身份、商品和金额后写入，旧订单不得直接补 true" },
        "transactionId": { "type": "string", "required": false, "description": "支付渠道交易号" },
        "amount": { "type": "number", "required": false, "description": "服务端定价，整数分" },
        "amountPaid": { "type": "number", "required": false, "description": "支付渠道核验的实付金额，整数分" },
        "createTime": { "type": "date", "required": true },
        "payTime": { "type": "date", "required": false }
      },
      "indexes": [
        { "name": "orderId", "keys": { "orderId": 1 }, "unique": true },
        { "name": "openid_status", "keys": { "_openid": 1, "status": 1 } }
      ]
    },
    {
      "name": "user_purchases",
      "description": "用户已购买商品",
      "securityRules": { "read": false, "write": false },
      "fields": {
        "_openid": { "type": "string", "required": true },
        "productId": { "type": "string", "required": true },
        "productName": { "type": "string", "required": true },
        "price": { "type": "number", "required": true },
        "orderId": { "type": "string", "required": true },
        "paymentVerified": { "type": "boolean", "required": false, "description": "仅可信支付服务写入，与已核验订单配对" },
        "transactionId": { "type": "string", "required": false },
        "purchaseTime": { "type": "date", "required": true }
      },
      "indexes": [
        { "name": "openid_product", "keys": { "_openid": 1, "productId": 1 }, "unique": true }
      ]
    },
    {
      "name": "user_profiles",
      "description": "用户资料",
      "fields": {
        "_openid": { "type": "string", "required": true },
        "nickname": { "type": "string", "required": false },
        "avatarUrl": { "type": "string", "required": false },
        "totalPlayTime": { "type": "number", "required": false, "default": 0 },
        "cycleCount": { "type": "number", "required": false, "default": 0 },
        "achievements": { "type": "array", "required": false },
        "vipLevel": { "type": "number", "required": false, "default": 0 },
        "createTime": { "type": "date", "required": true },
        "updateTime": { "type": "date", "required": true }
      },
      "indexes": [
        { "name": "openid", "keys": { "_openid": 1 }, "unique": true }
      ]
    }
  ]
}
